<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>ja</string>
    <key>CFBundleIdentifier</key>
    <string>dev.nayukata.hearcat</string>
    <key>CFBundleName</key>
    <string>HearCat</string>
    <key>CFBundleDisplayName</key>
    <string>HearCat</string>
    <key>CFBundleExecutable</key>
    <string>HearCat</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- 更新の有無は、このバージョンと main の同ファイルのバージョンを比べて判定する
         (UpdateCheck.swift)。main に変更を入れたら必ず上げる。README「バージョンの付け方」参照。
         PlistBuddy で書き換えるとこのコメントごと消えるため、編集は手で行う。 -->
    <key>CFBundleShortVersionString</key>
    <string>0.3.0</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <!-- メニューバー常駐アプリ。Dock には出さない。 -->
    <key>LSUIElement</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>HearCat は自分の発話をリアルタイム文字起こし・録音するためにマイクを使用します。</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>HearCat は音声をテキストに変換するために音声認識を使用します。</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>HearCat は通話相手など、Mac から出る音声を文字起こし・録音するためにシステム音声を録音します。</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>HearCat は今の予定名をセッション名として自動で付けたり、会議の時間になったら録音を自動で開始したりするためにカレンダーを読み取ります。</string>
    <!-- セッションの受け渡しファイル(.hearcat)。ダブルクリックで HearCat が開き、
         中身を確認してから取り込める(SessionPackage.swift 参照)。
         中身は zip だが com.pkware.zip-archive には conform させない。
         conform させるとアーカイブユーティリティが「解凍」の対象として横取りし、
         ダブルクリックでフォルダが展開されるだけになってしまうため。 -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>dev.nayukata.hearcat.session</string>
            <key>UTTypeDescription</key>
            <string>HearCat セッション</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>hearcat</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>HearCat セッション</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>dev.nayukata.hearcat.session</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
