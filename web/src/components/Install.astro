---
const BOOTSTRAP_CMD = "curl -fsSL https://raw.githubusercontent.com/nayukata/HearCat/main/bootstrap.sh | bash";
const reqs = [
  { k: "macOS 26 以降", v: "文字起こしには macOS 26 の音声認識機能を使用します。" },
  { k: "Apple Silicon 搭載 Mac", v: "要約機能は、Apple Intelligence が有効な環境で利用できます。" },
  { k: "Xcode 26", v: "ビルドに必要です。App Store から入れておいてください。" },
  { k: "Apple Development 証明書", v: "Xcode の「Settings → Accounts」から Apple ID を追加すると自動で作成されます。システム音声の取得にはこの署名が必要です。" },
];
const box = "clay px-[22px] py-[26px] md:px-[34px] md:py-8";
const code = "mt-3.5 flex items-center gap-3 rounded-[18px] bg-ink py-2.5 pr-2.5 pl-4 shadow-[inset_0_4px_8px_rgba(0,0,0,.4),inset_0_-2px_3px_rgba(255,255,255,.08)]";
const codeText = "min-w-0 flex-1 overflow-x-auto py-2 font-mono text-[13px] leading-[1.7] whitespace-nowrap text-[#FBEBD9]";
const copy = "min-h-9 shrink-0 cursor-pointer rounded-full border-0 bg-[#FBEBD9] px-4 font-sans text-[13px] font-black text-ink shadow-[0_3px_6px_rgba(0,0,0,.35)] hover:bg-white";
const step = "relative pb-7 pl-14 before:absolute before:top-0 before:left-0 before:flex before:size-[38px] before:items-center before:justify-center before:rounded-full before:bg-sage before:text-[17px] before:font-black before:text-white before:shadow-clay-dot-on before:content-[counter(g)] [counter-increment:g] last:pb-0";
---
<section id="install" class="bg-cream-3 py-16 md:py-[88px]">
  <div class="mx-auto max-w-[1120px] px-6">
    <h2 class="section-h2">1 行貼るだけ。あとは Mac が頑張ります。</h2>
    <p class="mx-auto mt-5 max-w-[40em] text-center text-[clamp(18px,2.2vw,22px)] leading-snug font-black text-balance">ビルドと署名まで、数分で終わります。</p>
    <p class="mx-auto mt-3 max-w-[40em] text-center text-[15px] text-ink-dim">システム音声のキャプチャに安定した署名が要るため、各自の Mac で自分の証明書を使ってビルドと署名をします。</p>

    <div class="mt-12 grid grid-cols-[minmax(0,1fr)] items-start gap-6 min-[881px]:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <div class={box}>
        <ol class="list-none [counter-reset:g]">
          <li class={step}>
            <b class="block pt-1 font-head text-lg leading-normal font-black">ターミナルを開いて、下のコマンドを貼り付け</b>
            <p class="mt-2 text-[15px] text-ink-dim">Mac 標準のターミナルアプリで大丈夫です。ソースの取得からビルド、<code class="font-mono text-[.92em]">~/Applications</code> へのアプリ配置、CLI の <code class="font-mono text-[.92em]">~/.local/bin/hearcat</code> への配置までまとめて行います。Xcode 開発者ツールが未導入なら、途中でダイアログが出るので「インストール」を押します。</p>
            <div class={code}>
              <div class={codeText} data-cmd-text><span class="text-[#E8B98A] select-none" aria-hidden="true">$ </span>{BOOTSTRAP_CMD}</div>
              <button type="button" class={copy} data-cmd={BOOTSTRAP_CMD} aria-label="導入のコマンドをコピー">コピー</button><span class="sr-only" role="status" aria-live="polite"></span>
            </div>
          </li>
          <li class={step}>
            <b class="block pt-1 font-head text-lg leading-normal font-black">メニューバーから「セッションを開始」</b>
            <p class="mt-2 text-[15px] text-ink-dim">マイクや音声認識、システム音声の許可を与えたら、あとは HearCat が聞き取ります。日本語の認識モデルは自動で取得されます。</p>
          </li>
        </ol>
      </div>
      <div class={box}>
        <h3 class="font-head text-xl font-black">動作環境</h3>
        {reqs.map((r) => (
          <p class="mt-3.5 text-[15px] text-ink-dim"><b class="block text-ink">{r.k}</b>{r.v}</p>
        ))}
      </div>
    </div>

    <div class={`${box} mt-6`}>
      <h3 class="font-head text-xl font-black">更新するには</h3>
      <p class="mt-2 text-[15px] text-ink-dim">導入と同じコマンドをもう一度実行すると、最新バージョンになります。</p>
      <div class={code}>
        <div class={codeText} data-cmd-text><span class="text-[#E8B98A] select-none" aria-hidden="true">$ </span>{BOOTSTRAP_CMD}</div>
        <button type="button" class={copy} data-cmd={BOOTSTRAP_CMD} aria-label="更新のコマンドをコピー">コピー</button><span class="sr-only" role="status" aria-live="polite"></span>
      </div>
      <p class="mt-3.5 text-[15px] text-ink-dim">AI エージェント連携がうまく動かない、macOS のアップデートで挙動が変わった、など何かおかしいと感じた時も、まずこのコマンドの再実行をお試しください。</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-cmd]").forEach((btn) => {
    const status = btn.nextElementSibling as HTMLElement | null;
    const text = btn.parentElement?.querySelector<HTMLElement>("[data-cmd-text]");
    let timer: ReturnType<typeof setTimeout> | undefined;
    const flash = (label: string, announce: string) => {
      clearTimeout(timer);
      const orig = btn.dataset.label ?? (btn.dataset.label = btn.textContent ?? "");
      btn.textContent = label;
      if (status) status.textContent = announce;
      timer = setTimeout(() => { btn.textContent = orig; if (status) status.textContent = ""; }, 2400);
    };
    const selectCommand = () => {
      if (!text) return;
      const range = document.createRange();
      range.selectNodeContents(text);
      const sel = window.getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
    };
    btn.addEventListener("click", async () => {
      const cmd = btn.getAttribute("data-cmd");
      try {
        if (!cmd || !navigator.clipboard) throw new Error("clipboard unavailable");
        await navigator.clipboard.writeText(cmd);
        flash("コピー済", "コマンドをコピーしました");
      } catch {
        selectCommand();
        flash("コピーできませんでした", "コピーできませんでした。選択したコマンドを手動でコピーしてください");
      }
    });
  });
</script>
