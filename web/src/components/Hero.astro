---
const tabs = ["文字起こし", "AI に質問", "決まったこと"];
const lines = [
  { who: "相手", text: "リリースは来週の金曜にずらしましょう", time: "14:31" },
  { who: "自分", text: "了解です、告知も合わせて直します。", time: "14:32" },
  { who: "相手", text: "検証環境の不具合がまだ残っていて", time: "14:33" },
];
---
<header id="top" class="-mt-[76px] bg-[linear-gradient(165deg,#FCE6D4_0%,#FFF0E0_55%,#FFF6EC_100%)] pt-[76px] pb-5 min-[861px]:pb-14">
  <div class="mx-auto grid max-w-[1120px] items-center gap-10 px-6 pt-10 min-[861px]:grid-cols-2">
    <div class="min-w-0">
      <h1 class="font-head text-[clamp(30px,9vw,56px)] leading-[1.3] font-black tracking-[.01em] whitespace-nowrap min-[861px]:text-[clamp(30px,4.4vw,60px)]">メモ、<br />取らなくていいよ。</h1>
      <p class="mt-7 max-w-[24em] text-[clamp(16px,1.5vw,19px)]">会議の声をその場で文字に。聞き逃したら、あとで AI に聞き返せる。</p>
      <a href="#install" class="clay-btn mt-9">Mac 版をダウンロード</a>
      <p class="mt-5 text-sm text-ink-dim">AI への質問には Claude Code などを使います。<a href="#local" class="block underline underline-offset-4">くわしくは「この Mac の中で」</a></p>
    </div>

    <div class="relative min-w-0 pb-[calc(33.5%-66px)]">
      <div class="relative z-[1]" data-carousel>
        <div class="clay relative rounded-clay-lg px-3.5 pt-3.5 pb-2.5 before:absolute before:inset-x-[22px] before:-top-2.5 before:-z-10 before:h-[30px] before:rounded-clay-lg before:bg-[#FFF4E6] before:shadow-clay-sm after:absolute after:inset-x-11 after:-top-[18px] after:-z-10 after:h-[30px] after:rounded-clay-lg after:bg-[#FFF4E6] after:opacity-85 after:shadow-clay-sm min-[861px]:before:-top-3.5 min-[861px]:before:h-10 min-[861px]:after:-top-[26px] min-[861px]:after:h-10">
          <div class="hidden gap-1.5 rounded-[22px] bg-sand p-1.5 shadow-well js:flex" role="tablist" aria-label="HearCat の画面">
            {tabs.map((t, i) => (
              <button
                type="button" role="tab" id={`tab-${i}`} data-tab
                aria-controls={`slide-${i}`} aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                class="min-h-11 flex-1 cursor-pointer [word-break:auto-phrase] rounded-2xl border-0 bg-transparent px-1 text-[13px] leading-tight font-bold text-ink transition aria-selected:bg-[linear-gradient(170deg,#E3EEDA,#CDE0BF)] aria-selected:font-black aria-selected:shadow-clay-sm min-[481px]:px-0 min-[481px]:text-[15px]"
              >{t}</button>
            ))}
          </div>
          <div class="mt-1.5 flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-track>
            <div class="min-w-0 flex-none basis-full snap-start px-3.5 pt-3.5 pb-[18px]" tabindex="0" role="tabpanel" id="slide-0" aria-labelledby="tab-0" data-slide>
              <ul class="list-none">
                {lines.map((l) => (
                  <li class="grid grid-cols-[auto_1fr] items-baseline gap-x-3.5 border-b border-ink/15 py-3 last:border-b-0 min-[481px]:grid-cols-[3em_1fr_auto] min-[481px]:py-4">
                    <span class="text-[15px] font-black">{l.who}</span>
                    <span class="col-span-2 row-start-2 text-pretty text-[15.5px] leading-relaxed min-[481px]:col-span-1 min-[481px]:col-start-2 min-[481px]:row-start-1 min-[481px]:text-[17px]">{l.text}</span>
                    <time class="col-start-2 row-start-1 justify-self-end font-mono text-[13px] text-ink-dim min-[481px]:col-start-3 min-[481px]:text-sm">{l.time}</time>
                  </li>
                ))}
              </ul>
            </div>
            <div class="min-w-0 flex-none basis-full snap-start px-3.5 pt-3.5 pb-[18px]" tabindex="0" role="tabpanel" id="slide-1" aria-labelledby="tab-1" data-slide>
              <div class="flex flex-col gap-[18px] pt-1.5">
                <p class="max-w-[92%] self-end rounded-[18px] bg-sand px-[18px] py-2.5 text-base font-bold shadow-well-sm min-[481px]:max-w-[80%]">延期の理由は何だった?</p>
                <p class="text-lg leading-[1.8] text-pretty">検証環境の不具合が残っているため、と相手が説明していました。</p>
                <span class="self-start rounded-full bg-sand px-2.5 py-0.5 font-mono text-[13px] text-ink-dim">14:33</span>
              </div>
            </div>
            <div class="min-w-0 flex-none basis-full snap-start px-3.5 pt-3.5 pb-[18px]" tabindex="0" role="tabpanel" id="slide-2" aria-labelledby="tab-2" data-slide>
              <ul class="flex list-none flex-col gap-3.5 pt-1.5">
                <li class="clay-sm relative bg-[#FFF8EF] py-4 pr-5 pl-[52px] text-lg leading-normal font-black [word-break:auto-phrase] before:absolute before:top-1/2 before:left-[18px] before:-mt-2.5 before:size-5 before:rounded-full before:bg-sage before:shadow-clay-dot-on">リリース日を 10/23 (金) に変更</li>
                <li class="clay-sm relative bg-[#FFF8EF] py-4 pr-5 pl-[52px] text-lg leading-normal font-black [word-break:auto-phrase] before:absolute before:top-1/2 before:left-[18px] before:-mt-2.5 before:size-5 before:rounded-full before:bg-sage before:shadow-clay-dot-on">告知文を新しい日付に直す</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="mt-3.5 hidden justify-start gap-1 pl-4 js:flex min-[861px]:pl-6" aria-hidden="true">
          {tabs.map((t, i) => (
            <button
              type="button" data-dot tabindex="-1" aria-current={i === 0 ? "true" : "false"}
              class="group relative size-7 cursor-pointer border-0 bg-transparent"
            >
              <span class="absolute inset-[7px] rounded-full bg-[#F3DEC8] shadow-clay-dot group-aria-[current=true]:bg-sage group-aria-[current=true]:shadow-clay-dot-on"></span>
            </button>
          ))}
        </div>
      </div>
      <img class="pointer-events-none absolute right-[-8px] bottom-0 z-[2] h-auto w-[58%]" src="/lp/clay-cat.webp" width="1200" height="693" alt="粘土でできた猫がノート PC の前にすわっている" />
    </div>
  </div>
</header>

<script>
  const root = document.querySelector<HTMLElement>("[data-carousel]");
  if (root) {
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const tabs = Array.from(root.querySelectorAll<HTMLElement>("[data-tab]"));
    const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-dot]"));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let current = 0;
    let timer: number | undefined;
    let hovering = false;
    let focusing = false;
    let touching = false;

    const render = (i: number) => {
      current = i;
      tabs.forEach((t, n) => {
        t.setAttribute("aria-selected", String(n === i));
        t.tabIndex = n === i ? 0 : -1;
      });
      dots.forEach((d, n) => d.setAttribute("aria-current", String(n === i)));
      slides.forEach((s, n) => { s.inert = n !== i; });
    };
    const go = (i: number, scroll = true) => {
      const next = (i + slides.length) % slides.length;
      render(next);
      if (scroll) track.scrollTo({ left: next * track.clientWidth, behavior: reduced.matches ? "auto" : "smooth" });
    };

    const stop = () => { if (timer !== undefined) { clearInterval(timer); timer = undefined; } };
    const sync = () => {
      stop();
      if (reduced.matches || hovering || focusing || touching || document.hidden) return;
      timer = window.setInterval(() => go(current + 1), 5000);
    };

    tabs.forEach((t, n) => {
      t.addEventListener("click", () => { go(n); sync(); });
      t.addEventListener("keydown", (e) => {
        const k = e.key;
        const to = k === "ArrowRight" ? n + 1 : k === "ArrowLeft" ? n - 1 : k === "Home" ? 0 : k === "End" ? slides.length - 1 : null;
        if (to === null) return;
        e.preventDefault();
        go(to);
        tabs[(to + slides.length) % slides.length].focus();
        sync();
      });
    });
    dots.forEach((d, n) => d.addEventListener("click", () => { go(n); sync(); }));

    let settle: number | undefined;
    track.addEventListener("scroll", () => {
      clearTimeout(settle);
      settle = window.setTimeout(() => {
        const i = Math.round(track.scrollLeft / track.clientWidth);
        if (i !== current) render(i);
      }, 80);
    }, { passive: true });
    window.addEventListener("resize", () => { track.scrollTo({ left: current * track.clientWidth, behavior: "auto" }); });

    root.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") { hovering = true; sync(); } });
    root.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") { hovering = false; sync(); } });
    root.addEventListener("focusin", (e) => { focusing = (e.target as HTMLElement).matches(":focus-visible"); sync(); });
    root.addEventListener("focusout", () => { focusing = false; sync(); });
    root.addEventListener("touchstart", () => { touching = true; sync(); }, { passive: true });
    root.addEventListener("touchend", () => { touching = false; sync(); }, { passive: true });
    root.addEventListener("touchcancel", () => { touching = false; sync(); }, { passive: true });
    document.addEventListener("visibilitychange", sync);
    reduced.addEventListener("change", sync);

    render(Math.min(slides.length - 1, Math.max(0, Math.round(track.scrollLeft / track.clientWidth))));
    sync();
  }
</script>
